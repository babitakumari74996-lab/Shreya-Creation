{
  "buildCommand": "cd Fashion-Room && npm run build && mkdir -p ../public-output && cp -r .vercel/output/static/* ../public-output/",
  "outputDirectory": "public-output",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}