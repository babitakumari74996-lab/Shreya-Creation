# ============================================================
# Environment variables — Aangan Boutique (client repo)
#
# Copy this file to .env for local dev (`Copy-Item .env.example .env`)
# or set the same names in the Render dashboard (Static Site ->
# Environment). Render rebuilds the app when these change, so values
# here are baked in at build time.
#
# NOTE: env var names are CASE-SENSITIVE (BUG 4.4). Dashboard and
# this file must use EXACTLY the same names.
#
# All of these are OPTIONAL — src/config/shop.config.ts falls back to
# the client defaults when a var is unset.
# ============================================================

# Shop identity
VITE_SHOP_NAME=Aangan Boutique
VITE_SHOP_TAGLINE=Sophisticated ethnic & western wear for the modern wardrobe
VITE_SHOP_FOUNDED_YEAR=2024

# Logo served from the repo public/ folder (absolute path — BUG 4.1)
VITE_SHOP_LOGO_PATH=/logo.png

# WhatsApp — DIGITS ONLY + country code (BUG 4.2). "91" + 10 digits.
VITE_WHATSAPP_NUMBER=919876543210

# Instagram handle (keep the @)
VITE_INSTAGRAM_HANDLE=@aanganboutique

# Contact email (leave blank until the client provides one)
VITE_CONTACT_EMAIL=info@aanganboutique.in

# Deployed site URL — JSON-LD `sameAs`
VITE_WEBSITE_URL=https://www.aanganboutique.in/

# "Find us on Map" button target (BUG 4.7: empty => "Map coming soon")
VITE_GOOGLE_MAPS_URL=https://www.google.com/maps/search/?api=1&query=Aangan+Boutique+K-158+Sindhu+Bhavan+Marg+Ahmedabad

# Google Maps embed (iframe) URL — optional
VITE_GOOGLE_MAPS_EMBED_URL=